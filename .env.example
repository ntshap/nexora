# Environment Configuration for Testnet Deployment

# Deployer Private Key (DO NOT COMMIT!)
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# Backup RPC
SEPOLIA_RPC_URL_BACKUP=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Backend API URL (will be updated after backend deployment)
API_BASE_URL=http://localhost:8000

# WalletConnect Project ID
WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Database (use PostgreSQL for production)
DATABASE_URL=postgresql://user:password@localhost:5432/nexora_testnet

# Redis for rate limiting
REDIS_URL=redis://localhost:6379/0

# Allowed origins (update after frontend deployment)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Monitoring (optional)
SENTRY_DSN=
POSTHOG_KEY=

# ===== COMPLIANCE & LEGAL (REQUIRED) =====
# Admin wallets for emergency controls (comma-separated)
ADMIN_WALLETS=0xYourAdminWallet1,0xYourAdminWallet2

# Alert webhooks for critical events
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Blocked countries (OFAC sanctions list)
BLOCKED_COUNTRIES=US,CN,KP,IR,SY,CU,VE,BY,MM,ZW
